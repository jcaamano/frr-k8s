  exit-address-family
+{{- end }}
+
+{{- if .SsNodesIPv6 }}
+ address-family ipv6 unicast
+{{- range $r := .SsNodesIPv6 }}
+  neighbor {{ . }} route-reflector-client
+  neighbor {{ . }} activate
+  neighbor {{ . }} next-hop-self
+{{- end }}
+  network 2001:db8::/128
+ exit-address-family
+{{- end }}
+{{- end }}
 
